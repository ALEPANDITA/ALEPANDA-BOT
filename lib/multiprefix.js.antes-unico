// lib/multiprefix.js
// Prefijos multiples SIEMPRE activos: el bot reconoce un comando con cualquiera de estos prefijos
// (. / ! # $ ...) en todos los grupos y en privado, sin importar el prefijo configurado.
// Solo cuenta si lo que sigue al prefijo es un comando que existe (asi "!hola" o "#amigos" no se confunden con comandos).
const PREFIJOS = ['.', '/', '!', '#', '$', '%', '&', '*', '+', '-', '=', '?', '~', '^', '_', ',', ';', ':', '|', '>', '<', '¡', '¿', '°', '•', '√', 'π', '÷', '×', '¶', '∆', '£', '¢', '€', '¥', '©', '®', '™'];

// texto: mensaje; base: prefijo configurado del grupo; comandos: Map de comandos; normalizar: normalizarComando del bot.
// Devuelve el prefijo que uso la persona, o null si no hay que cambiar nada (ya empezaba con el prefijo configurado o no es un comando).
function detectar(texto, base, comandos, normalizar) {
  const t = String(texto || '');
  if (!t) return null;
  if (base && t.startsWith(base)) return null;               // ya usa el prefijo normal: nada que cambiar
  const norm = typeof normalizar === 'function' ? normalizar : (x) => String(x || '').toLowerCase();
  const candidatos = [...new Set([...PREFIJOS])].sort((a, b) => b.length - a.length);
  for (const p of candidatos) {
    if (!t.startsWith(p)) continue;
    const nombre = t.slice(p.length).split(/\s+/)[0];
    if (!nombre) continue;
    if (comandos.get(norm(nombre))) return p;
  }
  return null;
}

module.exports = { detectar, PREFIJOS };
